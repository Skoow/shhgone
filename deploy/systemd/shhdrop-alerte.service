# Alerte de l'exploitant (deploy/alerte.sh ; README §4) : santé, disques, certificat, domaine,
# hébergement, DNS, sauvegarde, mises à jour, horloge ; bilan chaque semaine.
# Installation : copier ce fichier et shhdrop-alerte.timer dans /etc/systemd/system/, en
# remplaçant /opt/shhdrop par le chemin de la copie du dépôt, puis :
#   systemctl daemon-reload && systemctl enable --now shhdrop-alerte.timer
[Unit]
Description=Alerte de l'exploitant (Shhgone)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/shhdrop/deploy/alerte.sh
UMask=0077
# État : dates d'envoi et un échantillon d'occupation du disque par jour (aucune donnée
# d'utilisateur, aucune adresse) ; gardé au redémarrage pour le rythme du disque et le bilan.
StateDirectory=shhdrop-alerte
ProtectHome=read-only
PrivateTmp=yes
NoNewPrivileges=yes
TimeoutStartSec=2min
