# Purge du journal de la machine (README §1) : journald n'applique MaxRetentionSec qu'en
# écrivant ; sur une machine calme, une entrée (adresse vue par sshd ou le noyau) pourrait
# rester plus longtemps en mémoire. Ferme le fichier en cours, puis efface les fichiers fermés
# dont la dernière entrée a plus d'une heure.
# Installation : copier ce fichier et shhdrop-journal.timer dans /etc/systemd/system/, puis :
#   systemctl daemon-reload && systemctl enable --now shhdrop-journal.timer
# (deploy.sh refuse d'installer tant que le minuteur n'est pas activé.)
[Unit]
Description=Purge du journal de plus d'une heure (Shhgone)

[Service]
Type=oneshot
ExecStart=/usr/bin/journalctl --rotate --vacuum-time=1h
PrivateTmp=yes
NoNewPrivileges=yes
TimeoutStartSec=1min
