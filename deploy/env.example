# Réglages du serveur, à copier en deploy/.env (lu par deploy.sh). Aucun secret qui ouvre quoi
# que ce soit : pour le tableau de bord, seulement l'empreinte de son jeton (plus bas).

# Nom du site (le DNS doit déjà pointer vers ce serveur).
SHH_DOMAIN=shhgone.com

# Point de montage du volume chiffré (LUKS2), monté avec noatime (spec §15.1, §22).
SHH_DATA_ROOT=/srv/shhdrop

# Dépôt de l'image du serveur, sans étiquette ni empreinte. L'empreinte est donnée à deploy.sh.
SHH_IMAGE_REPO=registre.example/shhdrop

# Plafond de stockage en octets (défaut : 200 Gio). Le disque doit avoir 1 Gio de plus.
#SHH_STORAGE_MAX=214748364800

# Plafond de sortie par partage, en octets (README §11) : toutes ouvertures confondues, un
# partage ne sert pas plus que cela ; ensuite, téléchargements refusés (« egress_limit »).
# Défaut : 250 Gio (268435456000) ; au moins 32 Gio (un téléchargement complet d'un Pro de 30 Go).
#SHH_SHARE_EGRESS_MAX=268435456000

# Salon (spec §39) : ACTIVÉ dans compose.yaml (SHH_SALONS: "1", décision du propriétaire du
# 19 novembre, sans l'avis du juriste : Q-SAL8). Salons vivants au plus (défaut : 200) ; 50 proposé pour un
# usage personnel. Chaque création exige 2 Gio libres sous SHH_STORAGE_MAX.
#SHH_SALONS_MAX=50

# Capacité du serveur (README §11). Vide : calculée au démarrage d'après GOMEMLIMIT et la
# limite de descripteurs. Ne monter les envois qu'avec la mémoire (4 Mio chacun).
#SHH_UPLOADS_MAX=67
#SHH_DOWNLOADS_MAX=360
#SHH_WATCH_MAX=360
# WebSocket du salon : 64 Kio budgétés chacun (lot de rattrapage tenu par un client qui ne lit
# plus), 10 % de GOMEMLIMIT au plus : 1 440 avec 900 Mio ; au-delà, le serveur refuse de démarrer.
#SHH_WS_MAX=1440
# Appels de fichiers simultanés (fils du système bloqués sur le disque) ; les conversations
# du salon en ont le quart de plus pour leurs écritures, et autant pour leurs lectures. Le
# total (1,5 fois cette valeur) doit rester sous la moitié de pids_limit (1 024) : sinon le
# serveur refuse de démarrer.
#SHH_DISK_OPS_MAX=64
# Limite anti-abus : segments de 4 Mio par minute et par connexion (≈ 840 Mbit/s à 1 500).
#SHH_SEGMENTS_PER_MIN=1500
# Salon : trames non volatiles rangées au plus par salon (≈ 417 Mo de disque à 100 000).
#SHH_SALON_FRAMES_MAX=100000

# Tableau de bord d'administration (README §4) : désactivé tant que compose.yaml ne pose pas
# SHH_ADMIN_LISTEN. EMPREINTE SHA-256 du jeton, jamais le jeton : tirer le jeton sur son poste
# (JETON=$(openssl rand -hex 32)), le garder dans son gestionnaire de mots de passe, et mettre
# ici la sortie de : printf '%s' "$JETON" | sha256sum | cut -c1-64 (64 chiffres hexadécimaux).
# SHH_ADMIN_TOKEN (jeton en clair) est refusé au démarrage en production (SHH_BEHIND_PROXY=1).
#SHH_ADMIN_TOKEN_SHA256=

# Compte par passkey (README §12) : ACTIVÉ dans compose.yaml (SHH_COMPTES: "1", décision D8 du
# propriétaire, 19 novembre ; compte sans e-mail depuis le 22 novembre). Aucun réglage ici : la
# clé du serveur est un FICHIER de <SHH_DATA_ROOT>/secrets ; SHH_DOMAIN doit valoir shhgone.com
# (identifiant des passkeys, définitif). SHH_SMTP_* et SHH_MAIL_FROM ne servent plus : deploy.sh
# refuse d'installer s'ils sont encore là.
# Comptes au plus (défaut : 10 000) ; comptes créés au plus par jour, pour tout le serveur
# (coupe-circuit, défaut : 500).
#SHH_COMPTES_MAX=10000
#SHH_COMPTES_JOUR=500
# Alertes de l'exploitant (deploy/alerte.sh, README §4, « Surveillance ») : adresse qui reçoit
# les e-mails (urgences, ce qui est à prévoir, bilan chaque semaine). Vide : rien n'est envoyé.
# Envoyés depuis la machine (pas par le serveur Go), par un fournisseur SMTP authentifié (TLS
# implicite sur 465) ; mot de passe dans /etc/shhdrop/alerte_smtp_mdp (root 0600), jamais ici.
#SHH_ALERTE_A=contact@shhgone.com
#SHH_ALERTE_SMTP_HOST=smtp.fournisseur.example
#SHH_ALERTE_SMTP_USER=alertes@shhgone.com
# Entre apostrophes : la valeur contient des espaces et des chevrons (ce fichier est lu par bash).
#SHH_ALERTE_FROM='Shhgone <alertes@shhgone.com>'
# Fin de la location du serveur (AAAA-MM-JJ), lue dans l'espace client de l'hébergeur ; alerte
# à 45 jours puis à 7. À remettre à jour après chaque renouvellement.
#SHH_SERVEUR_ECHEANCE=2027-11-22
# Fin du domaine (AAAA-MM-JJ), seulement si RDAP ne la donne pas (l'alerte la lit chaque jour).
#SHH_DOMAINE_ECHEANCE=2027-11-22

# Paiement des offres Plus et Pro (README §13) : désactivé dans compose.yaml (SHH_PAIEMENT: "0").
# Aucun secret ici : les clés des prestataires sont des FICHIERS de <SHH_DATA_ROOT>/secrets
# (shh_stripe_cle, shh_stripe_webhook, shh_paypal_secret, shh_nowpayments_cle,
# shh_nowpayments_ipn) ; leurs chemins et les hôtes des relais sont posés par deploy.sh.
# Régime de TVA choisi par le propriétaire : franchise, france ou oss (oss : crypto ni
# proposée ni acceptée, une seule preuve de localisation ; décision du 24 novembre).
#SHH_TVA=
# 1 : Stripe Tax calcule la TVA (sinon prix TTC fixes).
#SHH_STRIPE_TAXE=0
# PayPal (avec le fichier shh_paypal_secret ; les trois ensemble) :
#SHH_PAYPAL_CLIENT_ID=
#SHH_PAYPAL_WEBHOOK_ID=
#SHH_PAYPAL_PLANS=plus-mois=P-…,plus-an=P-…,pro-mois=P-…,pro-an=P-…

# Sauvegarde quotidienne chiffrée de comptes.db et paiements.db (deploy/sauvegarder.sh, README §12). Clé
# PUBLIQUE age de l'exploitant (la clé privée reste hors ligne, à part de la copie de la clé
# du serveur) ; destination : stockage objet d'un autre fournisseur, dans l'UE, accès en
# écriture seule (identifiants : <SHH_DATA_ROOT>/sauvegarde-acces.curl, root 0600) ; version
# exacte d'age installée sur la machine (« age --version »).
#SHH_SAUVEGARDE_DESTINATAIRE=age1…
#SHH_SAUVEGARDE_URL=https://<seau>.<point d'accès S3>/comptes/
#SHH_AGE_VERSION=<version exacte>

# Appels audio et vidéo du salon (README §14) : activés par défaut, relais intégré, rien à
# installer ni à régler. SHH_APPELS=0 les coupe. SHH_TURN_IP : seulement derrière un routeur.
#SHH_APPELS=0
#SHH_TURN_IP=203.0.113.10
#SHH_TURN_ALLOCATIONS=60
#SHH_TURN_KBPS=2500
