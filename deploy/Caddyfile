# Caddyfile de Shhdrop (spec §8, §9.4, §10, §15, §28.7, §30, §35.1, §36 S1 à S3).
#
# Version exigée : Caddy 2.10 ou plus (courbe x25519mlkem768). Vérifié avec Caddy 2.11.9
# par deploy/test-proxy.sh. Aucun module ajouté : binaire officiel.
#
# Variables (lues dans l'environnement de Caddy) :
#   SHH_DOMAIN    nom du site, obligatoire (exemple : shhgone.com). Vide : Caddy refuse de démarrer.
#   SHH_UPSTREAM  adresse du serveur Go, par défaut 127.0.0.1:8080
#   SHH_HTTP_PORT, SHH_HTTPS_PORT  ports d'écoute (80 et 443 ; changés seulement par les tests)
#
# Ce que Caddy écrit quand même sur disque, journaux coupés : son dossier de données
# (/data dans l'image officielle) : clé du compte ACME, certificats et clés privées TLS,
# agrafes OCSP, verrous, instance.uuid, last_clean.json. Aucune adresse de client.
# persist_config off : pas de copie de la configuration (autosave.json).
#
# À faire chez le registraire, pas ici (spec §15.4) : DNSSEC, et un enregistrement
#   CAA 0 issue "letsencrypt.org"   (seul Let's Encrypt peut émettre ; cohérent avec acme_ca ci-dessous).
# www.{$SHH_DOMAIN} (24 novembre) : redirigé en 308 vers le site ; il lui faut ses enregistrements
# A et AAAA (mêmes adresses) et il prend son propre certificat, du même compte ACME (le CAA du
# nom s'applique aussi à www, README §1).
{
	# Ni API d'administration, ni métriques (spec §35.1).
	admin off
	persist_config off

	# Aucun journal : erreurs TLS comprises, elles contiennent l'adresse du client
	# (audit de confidentialité P6, spec §36 S1). Aucune directive « log » dans le site :
	# pas de journal d'accès (spec §9.4).
	# Conséquence : un renouvellement de certificat raté ne se voit pas ici ; la sonde
	# externe doit surveiller la date de fin du certificat (README).
	log default {
		output discard
	}

	# Let's Encrypt seulement (sans cette ligne, Caddy se replie sur ZeroSSL, que
	# l'enregistrement CAA de la spec §15.4 interdit). Pas d'e-mail de compte.
	acme_ca https://acme-v02.api.letsencrypt.org/directory

	http_port {$SHH_HTTP_PORT:80}
	https_port {$SHH_HTTPS_PORT:443}

	servers {
		# HTTP/1.1, HTTP/2 et HTTP/3 (décision du propriétaire du 13 novembre ; c'est aussi le
		# réglage par défaut de Caddy, écrit ici pour que test-proxy.sh le vérifie). HTTP/3 passe
		# par QUIC sur le port UDP 443 : à ouvrir dans le pare-feu (README §1). TLS 1.3 de QUIC
		# suit le bloc tls du site (courbes comprises). Caddy annonce HTTP/3 par l'en-tête
		# Alt-Svc (h3=":443") sur les réponses HTTP/1.1 et HTTP/2.
		protocols h1 h2 h3

		# Données anticipées de TLS 1.3 (0-RTT) refusées : Caddy 2.11.9 les accepte par défaut
		# en HTTP/3. Une requête reçue en 0-RTT arrive avant que l'adresse du client soit
		# vérifiée : {remote_host} est vide, le serveur Go reçoit « X-Shh-Client-IP: » vide et
		# répond 500 (échec fermé), et une requête de surveillance (GET /api/shares/watch) qui
		# suit un silence d'une demi-minute arrêtait la surveillance de révocation (audit adverse
		# du 13 novembre, 3e campagne, site, F1). Ces requêtes seraient aussi rejouables par qui
		# capte le premier vol de paquets. Contrôlé par test-proxy.sh (« allow_0rtt »: false).
		0rtt off

		# Jamais de « trusted_proxies » ici : aucun intermédiaire devant Caddy (spec §15.1).
		# L'adresse du client est celle du pair TCP, rien d'autre.

		# Le serveur Go pose ses propres délais (300 s par transfert, moins par segment).
		# Caddy ne coupe pas avant lui : mêmes 10 s pour les en-têtes, 5 min pour un corps
		# (segment de 4 Mio), 10 min pour la réponse (corps reçu + réponse).
		timeouts {
			read_header 10s
			read_body 5m
			write 10m
			idle 1m
		}
	}
}

# Réglages TLS communs au site et à www (un seul exemplaire : ils ne peuvent pas diverger).
(tls_shh) {
	tls {
		# Certificats de 6 jours (profil « shortlived » de Let's Encrypt, 22 novembre) : une clé
		# volée ne sert que quelques jours. Caddy renouvelle seul, bien avant la fin ; le compte
		# ACME et la clé du certificat ne quittent jamais le volume chiffré. Panne de Let's
		# Encrypt de plus de 2 jours : alerte URGENT (alerte.sh), retirer ces 4 lignes pour
		# revenir aux certificats de 90 jours (README, « Hébergeur et certificat »).
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
			profile shortlived
		}
		# TLS 1.3 seulement : l'échange de clés hybride n'existe pas en TLS 1.2.
		protocols tls1.3
		# Hybride post-quantique d'abord, X25519 seul en repli (spec §30, Q-PQ1).
		curves x25519mlkem768 x25519
	}
}

# Préproduction (README §15) : barrière choisie par SHH_PREPROD (posée par deploy.sh
# et preprod.sh : « 0 » ou « 1 » ; toute autre valeur fait refuser la configuration à Caddy, faute
# de snippet de ce nom). barriere-0 : production, rien de changé. barriere-1 : le public ne voit
# que deploy/maintenance.html (503). Jeton : 64 chiffres hexadécimaux (256 bits), fichier root
# 0600 /etc/shhdrop/preprod-jeton, jamais dans git ni dans deploy/.env. Passent seulement :
#   - /acces/<jeton> : pose le témoin __Host-shh_preprod=<jeton> (30 jours) et redirige vers / ;
#     le propriétaire ouvre ce lien une fois par appareil ;
#   - une requête qui porte le jeton : témoin __Host-shh_preprod (navigations du propriétaire,
#     WebSocket), ou en-tête X-Shh-Preprod (contrôles de deploy.sh et preprod.sh) ;
#   - les webhooks des prestataires de paiement (POST, trois chemins exacts) : ils arrivent sans
#     témoin, leur signature est vérifiée par le serveur Go ;
#   - une requête qui n'est pas une navigation et que le navigateur dit venir d'une page de cette
#     origine (Sec-Fetch-Site: same-origin, hors Sec-Fetch-Mode: navigate) : le site envoie ses
#     appels (API du salon et du paiement, WebAssembly, preuve anti-robot) avec
#     credentials: "omit", donc SANS témoin ; sans cette exception, il ne marcherait pas.
#     LIMITE : un client qui n'est pas un navigateur peut écrire cet en-tête et joindre l'API
#     (README §15, risque PP1).
# Le défi ACME (port 80, ou TLS-ALPN) est traité par Caddy avant ces blocs : aucune exemption.
# Comparaisons de chaînes de Caddy, pas en temps constant : acceptable avec 256 bits (README §15).
# Ni le jeton, ni le témoin n'atteignent le serveur Go (Cookie et X-Shh-Preprod retirés plus
# bas) ; aucun journal (global, ci-dessus).
(barriere-0) {
}

(entetes_preprod) {
	header {
		Content-Security-Policy "default-src 'none'; style-src 'sha256-Bpuq1l8Fe18wgWqa4Xc9+n3T4Hk/a9Da0z13ZBP1UIo='; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Permissions-Policy "microphone=(), camera=(), publickey-credentials-create=(), publickey-credentials-get=(), geolocation=(), display-capture=(), clipboard-read=(), usb=(), serial=(), hid=(), payment=(), gyroscope=(), accelerometer=(), magnetometer=(), midi=(), xr-spatial-tracking=(), browsing-topics=(), interest-cohort=()"
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Resource-Policy same-origin
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Robots-Tag "noindex, nofollow"
	}
}

(barriere-1) {
	# Aucun cache navigateur en préproduction : chaque
	# version se voit tout de suite, fichiers à empreinte de /assets/ compris. Posé après la
	# réponse (« > ») : remplace le Cache-Control du serveur Go. Le site n'a pas de service worker.
	header >Cache-Control no-store
	header X-Shhdrop-Etat preprod

	# Chemin exact (le filtre « path » de Caddy ignore la casse) ; jeton de la bonne forme exigé
	# (jeton vide : rien ne passe).
	@preprod_acces expression `{http.request.uri.path} == "/acces/{$SHH_PREPROD_JETON}" && "{$SHH_PREPROD_JETON}".matches("^[0-9a-f]{64}$")`
	@preprod_maintenance {
		not expression `{http.request.uri.path} == "/acces/{$SHH_PREPROD_JETON}" && "{$SHH_PREPROD_JETON}".matches("^[0-9a-f]{64}$")`
		not expression `({http.request.header.X-Shh-Preprod} == "{$SHH_PREPROD_JETON}" || {http.request.cookie.__Host-shh_preprod} == "{$SHH_PREPROD_JETON}") && "{$SHH_PREPROD_JETON}".matches("^[0-9a-f]{64}$")`
		not {
			method POST
			path_regexp ^/api/paiement/webhook/(stripe|paypal|nowpayments)$
		}
		not {
			header Sec-Fetch-Site same-origin
			not header Sec-Fetch-Mode navigate
		}
	}
	handle @preprod_maintenance {
		import entetes_preprod
		header {
			Content-Type "text/html; charset=utf-8"
			Retry-After 3600
			X-Shhdrop-Etat maintenance
		}
		respond "{file.{$SHH_MAINTENANCE:/etc/caddy/maintenance.html}}" 503
	}
	handle @preprod_acces {
		import entetes_preprod
		# 30 jours ; Lax et non Strict : envoyé aussi au retour d'une page de paiement (navigation
		# de premier niveau venue d'un autre site). HttpOnly : aucun script ne le lit.
		header Set-Cookie "__Host-shh_preprod={$SHH_PREPROD_JETON}; Path=/; Max-Age=2592000; Secure; HttpOnly; SameSite=Lax"
		# « * » : sans lui, « / » serait lu comme un filtre de chemin et la requête irait au
		# serveur Go (test-preprod.sh le vérifie).
		redir * / 303
	}
}

# Port 80 : redirection vers HTTPS, et défi ACME (traité par Caddy avant ce bloc). Écrit
# en toutes lettres pour que les délais et protocoles ci-dessus s'y appliquent aussi (la
# redirection automatique de Caddy crée un serveur à part, avec ses réglages par défaut).
# www aussi, vers HTTPS sur le même nom d'abord (règle du préchargement HSTS), puis vers le site.
http://{$SHH_DOMAIN}, http://www.{$SHH_DOMAIN} {
	# « Server: Caddy » retiré (voir le bloc du site ci-dessous).
	header -Server
	redir https://{host}{uri} 308
}

# www : redirection permanente (308) vers le site, chemin et requête gardés ({uri}). Rien
# d'autre : aucun contenu, aucun relais vers le serveur Go, aucun journal (global ci-dessus).
www.{$SHH_DOMAIN} {
	import tls_shh
	header -Server
	redir https://{$SHH_DOMAIN}{uri} 308
}

{$SHH_DOMAIN} {
	import tls_shh

	# Pas de « encode », pas de « templates », aucune réécriture : Caddy ne change aucun
	# octet des réponses (spec §28.7). Le serveur Go sert lui-même les variantes .br et
	# .gz du site, et rien de compressé sous /api (pas de BREACH, spec §10).

	# Plus qu'un segment (4 195 376 octets) : au-delà, 413 sans déranger le serveur Go,
	# qui garde ses propres plafonds exacts.
	request_body {
		max_size 5MiB
	}

	# « Via: 1.1 Caddy » : ajouté par Caddy aux réponses relayées, retiré. « Server: Caddy » :
	# Caddy le retire déjà des réponses relayées (le serveur Go n'en envoie pas), mais le pose
	# sur celles qu'il fabrique lui-même (308 du port 80, 413, 502 si le serveur Go est arrêté) :
	# retiré ici, sur le port 80 et dans handle_errors (audit du 11 novembre : rien ne dit quel
	# logiciel répond). Tous les en-têtes de sécurité (CSP, HSTS, etc.) viennent du serveur Go
	# (server/internal/api/headers.go) : ne pas les répéter ici, ils seraient en double.
	# Les réponses que Caddy fabrique lui-même sont vides et ne portent aucun de ces en-têtes.
	header -Via
	header -Server

	# 413 de request_body, 502 du proxy : la réponse d'erreur, sans « Server » ; rien n'est
	# écrit dans le corps (vide, comme sans ce bloc).
	handle_errors {
		header -Server
	}

	# Barrière de préproduction (plus haut) : vide en production.
	import barriere-{$SHH_PREPROD:0}

	reverse_proxy {$SHH_UPSTREAM:127.0.0.1:8080} {
		# LIGNE CRITIQUE (audit de sécurité F3) : REMPLACE toute valeur envoyée par le
		# client, une ou plusieurs, par l'adresse du pair TCP. Jamais « +X-Shh-Client-IP ».
		# {remote_host} et non {client_ip} : ne dépend d'aucun réglage « trusted_proxies ».
		header_up X-Shh-Client-IP {remote_host}

		# Rien d'autre ne porte l'adresse en aval (le serveur Go ne lit aucun de ces en-têtes).
		header_up -X-Forwarded-For
		header_up -X-Forwarded-Host
		header_up -X-Forwarded-Proto
		header_up -Forwarded
		header_up -X-Real-IP
		header_up -Via

		# Minimisation (spec §36 S2) : le serveur ne reçoit pas ce qui décrit le navigateur.
		# Accept-Encoding reste : il choisit la variante .br ou .gz d'un fichier du site.
		header_up -User-Agent
		header_up -Referer
		header_up -Accept-Language
		header_up -Cookie
		# Jeton de préproduction (contrôles de deploy.sh) : reste à Caddy.
		header_up -X-Shh-Preprod
		header_up -Sec-CH-UA*
		header_up -Sec-Fetch-*
		header_up -DNT
		header_up -Priority

		transport http {
			# Accept-Encoding transmis tel quel : Caddy n'ajoute pas « gzip » de lui-même
			# et ne décompresse rien.
			compression off
			dial_timeout 2s
		}
	}
}
