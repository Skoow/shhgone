# Réglages et état propres à chaque serveur (rien à publier ; .env ne porte que l'empreinte du
# jeton du tableau de bord, jamais le jeton : README §4).
/.env
/.release
/.release.prev
/.release.version
/.release.prev.version
/.release.commit
/.release.prev.commit
# Manifestes signés déjà vérifiés (deploy/provenance.sh), revérifiés à chaque installation.
/.provenance/
/.deploy.lock
# Garde-fou : secrets et sauvegardes n'ont rien à faire dans la copie du dépôt (README §12).
/secrets/
/shh_comptes_cle
/shh_smtp_mdp
*.age
*.curl
